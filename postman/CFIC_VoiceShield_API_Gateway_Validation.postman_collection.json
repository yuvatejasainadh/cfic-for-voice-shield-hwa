            "description": "Single request under rate limit window succeeds."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has valid request_id\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.request_id).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Burst Limit Exceeded (429 Rate Limit Exceeded)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{sample_audio_path}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/analyze",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "analyze"
              ]
            },
            "description": "Simulates burst rate limit exceeding window quota, expecting 429 and Retry-After header."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 429 Too Many Requests\", function () {",
                  "    pm.response.to.have.status(429);",
                  "});",
                  "pm.test(\"Error code is RATE_LIMIT_EXCEEDED\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.error_code).to.eql(\"RATE_LIMIT_EXCEEDED\");",
                  "});",
                  "pm.test(\"Retry-After header is present and integer\", function () {",
                  "    pm.expect(pm.response.headers.has(\"Retry-After\")).to.be.true;",
                  "    const retryAfter = parseInt(pm.response.headers.get(\"Retry-After\"), 10);",
                  "    pm.expect(retryAfter).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
