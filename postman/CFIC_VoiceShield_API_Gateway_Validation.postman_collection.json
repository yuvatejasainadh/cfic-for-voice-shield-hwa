    {
      "name": "1. Health and Discovery",
      "description": "Endpoints for load balancer probes, system health verification, and interactive API documentation.",
      "item": [
        {
          "name": "GET System Root Health (/health)",
          "request": {
            "method": "GET",
            "header": [],
            "body": null,
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Root health probe used by container orchestrators and load balancers."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Health status is ok and service is cfic-api\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.status).to.eql(\"ok\");",
