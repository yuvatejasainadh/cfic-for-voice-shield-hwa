    {
      "name": "3. Rate Limiting",
      "description": "Sliding-window rate limiter enforcement per client IP + key fingerprint, Retry-After header delivery, and stale memory eviction.",
      "item": [
        {
          "name": "Request Within Normal Rate Limit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
