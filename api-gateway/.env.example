# ==============================================================================
# CFIC API Gateway — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the service:
#   copy .env.example .env (Windows)
# ==============================================================================

# Application Environment (development, testing, production)
CFIC_ENV=development

# Service Name
CFIC_APP_NAME=CFIC-VoiceShield-API-Gateway

# CFIC API Key for VoiceShield client authentication
CFIC_API_KEY=replace-me-for-local-testing

# Request Rate Limiting (enforced in-memory for single instance)
CFIC_RATE_LIMIT_REQUESTS=30
CFIC_RATE_LIMIT_WINDOW_SECONDS=60

# Max audio upload size in bytes (default 25 MiB: 26214400 bytes)
CFIC_MAX_AUDIO_BYTES=26214400

# Cloud Inference Subsystem URL (internal orchestration)
CFIC_CLOUD_INFERENCE_URL=http://cloud-inference-orchestrator:8200
CFIC_CLOUD_INFERENCE_TIMEOUT=30.0

# Downstream legacy services (transitional fallback)
CFIC_PELLA_BASE_URL=http://localhost:8101
CFIC_TRANSCRIPTION_BASE_URL=http://localhost:8102

# Hosted AskDrip LLM Risk Assessment API (RIAS Stage 2)
CFIC_ASKDRIP_LLM_BASE_URL=https://api.askdrip.example/v1/risk-assessment
CFIC_ASKDRIP_LLM_API_KEY=replace-with-askdrip-api-key
CFIC_ASKDRIP_LLM_MODEL=askdrip-risk-v1

# Downstream Request Timeout in seconds
CFIC_REQUEST_TIMEOUT_SECONDS=30.0
