# Virtual environments
.venv/
.venv-*/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment files and secrets (NEVER commit secrets!)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*

# Model weights and artifacts (do not commit binary models)
/models/
artifacts/
weights/*
!weights/.gitkeep
**/weights/*
!**/weights/.gitkeep
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.nemo
*.gguf
*.tflite
*.joblib
*.ckpt

# Storage and audio runtime uploads
storage/
audio_samples/
datasets/
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.aac

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
